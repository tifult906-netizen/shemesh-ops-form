# Shemesh ops-form — environment template.
# Copy to `.env` and fill in real values. NEVER commit the real `.env`.
# All variables are OPTIONAL; the app runs offline with the `mock` vision
# backend and sane defaults if none are set.

# --- Vision backend --------------------------------------------------------
# mock   = offline canned values (default, no GPU/network — used by tests)
# ollama = local inference via the Ollama daemon (private, stays on-machine)
# openai = OpenAI cloud (BEST Hebrew, but client images LEAVE the machine)
# none   = skip the vision pass entirely (Hebrew labels stay empty)
SHEMESH_VISION=mock

# Model tag for the active backend (ollama: e.g. qwen2.5vl:7b; openai: e.g. gpt-4o-mini)
# SHEMESH_VISION_MODEL=qwen2.5vl:7b

# OpenAI backend credentials (only read when SHEMESH_VISION=openai).
# OPENAI_API_KEY=sk-...
# SHEMESH_OPENAI_KEY=sk-...        # alternative name, takes precedence over OPENAI_API_KEY only if OPENAI_API_KEY unset

# Ollama daemon host (only used when SHEMESH_VISION=ollama).
# OLLAMA_HOST=http://localhost:11434

# --- Web server ------------------------------------------------------------
# Bind address + port for `python -m shemesh_ops.web`.
# SHEMESH_HOST=127.0.0.1
# SHEMESH_PORT=8000

# Show full exception detail + tracebacks on the error page. Leave UNSET in
# production — tracebacks can leak file paths and client data to end users.
# SHEMESH_DEBUG=0

# --- Storage / retention ---------------------------------------------------
# SQLite submissions DB path (default: ~/.shemesh-ops/submissions.db).
# SHEMESH_DB=

# On-disk session upload root (default: ~/.shemesh-ops/sessions).
# SHEMESH_SESSION_ROOT=

# Auto-purge saved submissions (+ their PDFs) older than N days on startup.
# SHEMESH_SUBMISSION_RETENTION_DAYS=90

# --- Insurance directory ---------------------------------------------------
# Path to the real (company x product -> email) CSV. Falls back to the shipped
# example template if unset/missing.
# SHEMESH_INSURANCE_CSV=

# --- PDF fonts (Hebrew) ----------------------------------------------------
# TTF used to render the RTL PDF. Defaults to Windows Arial; on Linux/Mac point
# these at a Hebrew-capable font (e.g. a Noto Sans Hebrew TTF).
# SHEMESH_FONT_PATH=C:/Windows/Fonts/arial.ttf
# SHEMESH_FONT_BOLD_PATH=C:/Windows/Fonts/arialbd.ttf
